            "limit": {
              "type": "integer",
              "description": "1-20"
            }
          },
          "required": [
            "query"
          ]
        },
        "phrases": [
          "найди трек {query}",
          "найди в музыке {query}",
          "поищи трек {query}"
        ],
        "phrases_en": [
          "find the track {query}",
          "search music for {query}"
        ]
      },
      {
        "id": "radio",
        "title": "Радио по треку",
        "title_en": "Radio from a track",
        "run": {
          "handler": "music.radio"
        },
        "description": "Включить похожие треки из библиотеки, начиная с указанного трека (без трека — с текущего)",
        "description_en": "Play similar tracks from the library, starting with the given track (no track — the current one)",
        "args": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "track / artist"
            },
            "track_id": {
              "type": "string"
            }
          }
        },
        "phrases": [
          "включи радио по треку {query}",
          "радио {query}",
          "включи радио"
        ],
        "phrases_en": [
          "play radio based on {query}",
          "radio {query}",
          "play radio"
        ]
      },
