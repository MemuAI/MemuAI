{
  "id": "music",
  "title": "MemuMusic",
  "title_en": "MemuMusic",
  "summary": "Локальная музыка как Spotify: библиотека, плейлисты, скачивание по любой ссылке, синхронные тексты, эквалайзер и живой полноэкранный плеер.",
  "summary_en": "Local music like Spotify: library, playlists, download from any link, synced lyrics, an equalizer and a living full-screen player.",
  "version": "1.0",
  "icon": "icon.svg",
  "enabled": true,
  "launcher": {
    "hidden": false,
    "slot": "sidebar"
  },
  "window": {
    "default_width": 1280,
    "default_height": 820,
    "min_width": 720,
    "min_height": 480,
    "max_width": 3200,
    "max_height": 2000,
    "fixed": false,
    "resizable": true,
    "size_mode": "user",
    "center": true
  },
  "persist": [
    "player",
    "prefs",
    "recent_searches"
  ],
  "permissions": [
    "music",
    "chat",
    "models",
    "web",
    "storage",
    "clipboard",
    "download",
    "external",
    "notify"
  ],
  "bridge": {},
  "contributes": {
    "panels": [
      {
        "id": "now-playing",
        "title": "Сейчас играет",
        "title_en": "Now playing",
        "icon": "music",
        "size": "m",
        "height": 200,
        "summary": "Обложка, трек и управление — пауза, назад, дальше",
        "summary_en": "Cover, track and controls — pause, previous, next",
        "entry": "integration/panel.html",
        "scripts": [
          "integration/panels.js"
        ],
        "styles": [
          "integration/panels.css"
        ]
      },
      {
        "id": "playlist",
        "title": "Плейлист",
        "title_en": "Playlist",
        "icon": "music",
        "size": "m",
        "height": 262,
        "summary": "Выберите плейлист — обложки, треки и запуск в один клик",
        "summary_en": "Pick a playlist — covers, tracks and one-click play",
        "entry": "integration/panel.html",
        "scripts": [
          "integration/panels.js"
        ],
        "styles": [
          "integration/panels.css"
        ]
      },
      {
        "id": "stats",
        "title": "Статистика прослушиваний",
        "title_en": "Listening stats",
        "icon": "chart",
        "size": "m",
        "height": 230,
        "summary": "Часы музыки, прослушивания по дням, любимые исполнители",
        "summary_en": "Hours played, plays by day, top artists",
        "entry": "integration/panel.html",
        "scripts": [
          "integration/panels.js"
        ],
        "styles": [
          "integration/panels.css"
        ]
      }
    ],
    "commands": [
      {
        "id": "play",
        "title": "Включить трек",
        "title_en": "Play a track",
        "run": {
          "handler": "music.play"
        },
        "description": "Найти трек или исполнителя в библиотеке MemuMusic и включить (без запроса — продолжить)",
        "description_en": "Find a track or artist in the MemuMusic library and play it (no query — resume)",
        "args": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "track / artist / album"
            }
          }
        },
        "phrases": [
          "включи трек {query}",
          "включи песню {query}",
          "поставь трек {query}",
          "поставь песню {query}",
          "включи музыку {query}"
        ],
        "phrases_en": [
          "play the track {query}",
          "play the song {query}",
          "play some {query}"
        ]
      },
      {
        "id": "playlist",
        "title": "Включить плейлист",
        "title_en": "Play a playlist",
        "run": {
          "handler": "music.playlist"
        },
        "description": "Включить плейлист MemuMusic по названию; без названия — список плейлистов",
        "description_en": "Play a MemuMusic playlist by name; without a name — list the playlists",
        "args": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "shuffle": {
              "type": "boolean"
            }
          }
        },
        "phrases": [
          "включи плейлист {name}",
          "поставь плейлист {name}"
        ],
        "phrases_en": [
          "play the playlist {name}",
          "play playlist {name}"
        ]
      },
      {
        "id": "pause",
        "title": "Пауза",
        "title_en": "Pause",
        "run": {
          "handler": "music.pause"
