{
  "id": "music",
  "title": "MemuMusic",
  "title_en": "MemuMusic",
  "summary": "Локальная музыка как Spotify: библиотека, плейлисты, скачивание по любой ссылке, синхронные тексты, эквалайзер и живой полноэкранный плеер.",
  "summary_en": "Local music like Spotify: library, playlists, download from any link, synced lyrics, an equalizer and a living full-screen player.",
  "version": "1.0",
  "icon": "icon.svg",
  "enabled": true,
  "launcher": {
    "hidden": false,
    "slot": "sidebar"
  },
  "window": {
    "default_width": 1280,
    "default_height": 820,
    "min_width": 720,
    "min_height": 480,
    "max_width": 3200,
    "max_height": 2000,
    "fixed": false,
    "resizable": true,
    "size_mode": "user",
    "center": true
  },
  "persist": [
    "player",
    "prefs",
    "recent_searches"
  ],
  "permissions": [
    "music",
    "storage",
    "clipboard",
    "download",
    "external",
    "notify"
  ],
  "bridge": {},
  "contributes": {
    "panels": [
      {"id": "now-playing", "title": "Сейчас играет", "title_en": "Now playing", "icon": "music", "size": "m", "height": 200,
       "summary": "Обложка, трек и управление — пауза, назад, дальше", "summary_en": "Cover, track and controls — pause, previous, next",
       "entry": "integration/panel.html", "scripts": ["integration/panels.js"], "styles": ["integration/panels.css"]},
      {"id": "playlist", "title": "Плейлист", "title_en": "Playlist", "icon": "music", "size": "m", "height": 262,
       "summary": "Выберите плейлист — обложки, треки и запуск в один клик", "summary_en": "Pick a playlist — covers, tracks and one-click play",
       "entry": "integration/panel.html", "scripts": ["integration/panels.js"], "styles": ["integration/panels.css"]},
      {"id": "stats", "title": "Статистика прослушиваний", "title_en": "Listening stats", "icon": "chart", "size": "m", "height": 230,
       "summary": "Часы музыки, прослушивания по дням, любимые исполнители", "summary_en": "Hours played, plays by day, top artists",
       "entry": "integration/panel.html", "scripts": ["integration/panels.js"], "styles": ["integration/panels.css"]}
    ],
    "commands": [
      {"id": "play", "title": "Включить трек", "title_en": "Play a track", "run": {"handler": "music.play"},
       "description": "Найти трек или исполнителя в библиотеке MemuMusic и включить (без запроса — продолжить)",
       "description_en": "Find a track or artist in the MemuMusic library and play it (no query — resume)",
       "args": {"type": "object", "properties": {"query": {"type": "string", "description": "track / artist / album"}}},
       "phrases": ["включи трек {query}", "включи песню {query}", "поставь трек {query}", "поставь песню {query}", "включи музыку {query}"],
       "phrases_en": ["play the track {query}", "play the song {query}", "play some {query}"]},
      {"id": "playlist", "title": "Включить плейлист", "title_en": "Play a playlist", "run": {"handler": "music.playlist"},
       "description": "Включить плейлист MemuMusic по названию; без названия — список плейлистов",
       "description_en": "Play a MemuMusic playlist by name; without a name — list the playlists",
       "args": {"type": "object", "properties": {"name": {"type": "string"}, "shuffle": {"type": "boolean"}}},
       "phrases": ["включи плейлист {name}", "поставь плейлист {name}"], "phrases_en": ["play the playlist {name}", "play playlist {name}"]},
      {"id": "pause", "title": "Пауза", "title_en": "Pause", "run": {"handler": "music.pause"},
       "description": "Поставить музыку на паузу", "description_en": "Pause the music",
       "phrases": ["пауза музыки", "поставь музыку на паузу", "останови музыку"], "phrases_en": ["pause the music", "stop the music"]},
      {"id": "resume", "title": "Продолжить", "title_en": "Resume", "run": {"handler": "music.resume"},
       "description": "Продолжить воспроизведение", "description_en": "Resume playback",
       "phrases": ["продолжи музыку", "включи музыку"], "phrases_en": ["resume the music"]},
      {"id": "next", "title": "Следующий трек", "title_en": "Next track", "run": {"handler": "music.next"},
       "description": "Следующий трек", "description_en": "Next track",
       "phrases": ["следующий трек", "следующая песня", "переключи трек"], "phrases_en": ["next track", "next song", "skip this song"]},
      {"id": "prev", "title": "Предыдущий трек", "title_en": "Previous track", "run": {"handler": "music.prev"},
       "description": "Предыдущий трек", "description_en": "Previous track",
       "phrases": ["предыдущий трек", "предыдущая песня"], "phrases_en": ["previous track", "previous song"]},
      {"id": "volume", "title": "Громкость музыки", "title_en": "Music volume", "run": {"handler": "music.volume"},
       "description": "Громкость MemuMusic 0–100", "description_en": "MemuMusic volume 0–100",
       "args": {"type": "object", "properties": {"level": {"type": "integer", "description": "0-100"}}, "required": ["level"]},
       "phrases": ["громкость музыки {level}"], "phrases_en": ["music volume {level}"]},
      {"id": "now", "title": "Что сейчас играет", "title_en": "What is playing", "run": {"handler": "music.now"},
       "description": "Что сейчас играет в MemuMusic", "description_en": "What MemuMusic is playing now",
       "phrases": ["что сейчас играет", "что играет", "что за песня"], "phrases_en": ["what is playing", "what song is this"]},
      {"id": "download", "title": "Скачать по ссылке", "title_en": "Download by link", "run": {"handler": "music.download"},
       "description": "Скачать трек/альбом/плейлист по ссылке в библиотеку MemuMusic",
       "description_en": "Download a track/album/playlist by link into the MemuMusic library",
       "args": {"type": "object", "properties": {"url": {"type": "string"}}, "required": ["url"]},
       "phrases": ["скачай {url}", "скачай трек {url}", "скачай музыку {url}"], "phrases_en": ["download {url}"]}
    ],
    "skill": "integration/skill.md",
    "widgets": [
      {"id": "dock", "slot": "main.dock", "kind": "dock", "source": "music.player",
       "title": "Док-плеер в главном окне", "title_en": "Dock player in the main window",
       "settings": [{"key": "mode", "type": "choice", "label": "Показывать", "label_en": "Show", "default": "always",
                     "choices": [{"value": "always", "label": "Всегда", "label_en": "Always"},
                                 {"value": "playing", "label": "Только когда играет", "label_en": "Only while playing"},
                                 {"value": "off", "label": "Выключен", "label_en": "Off"}]}]},
      {"id": "eq-ring", "slot": "quick.ring", "kind": "equalizer", "source": "music.player",
       "title": "Эквалайзер вокруг Быстрого доступа", "title_en": "Equalizer around Quick Access",
       "settings": [
         {"key": "enabled", "type": "bool", "label": "Показывать, пока играет музыка", "label_en": "Show while music plays", "default": true},
         {"key": "style", "type": "choice", "label": "Стиль", "label_en": "Style", "default": "bars",
          "choices": [{"value": "bars", "label": "Столбики", "label_en": "Bars"}, {"value": "glow", "label": "Свечение", "label_en": "Glow"},
                      {"value": "wave", "label": "Волна", "label_en": "Wave"}]},
         {"key": "color", "type": "choice", "label": "Цвет", "label_en": "Colour", "default": "cover",
          "choices": [{"value": "cover", "label": "Из обложки", "label_en": "From the cover"}, {"value": "accent", "label": "Акцент MemuAI", "label_en": "MemuAI accent"}]}
       ]},
      {"id": "quick-card", "slot": "quick.card", "kind": "nowplaying", "source": "music.player",
       "title": "Карточка «Сейчас играет» в Быстром доступе", "title_en": "“Now playing” card in Quick Access",
       "settings": [{"key": "enabled", "type": "bool", "label": "Показывать, пока играет музыка", "label_en": "Show while music plays", "default": true}]},
      {"id": "chat-mini", "slot": "chat.composer", "kind": "miniplayer", "source": "music.player",
       "title": "Мини-плеер над полем ввода чата", "title_en": "Mini player above the chat box",
       "settings": [{"key": "enabled", "type": "bool", "label": "Показывать, пока играет музыка", "label_en": "Show while music plays", "default": false},
                    {"key": "eq", "type": "bool", "label": "Живой эквалайзер", "label_en": "Live equalizer", "default": true}]},
      {"id": "chat-cards", "slot": "chat.cards", "kind": "cards", "source": "music.player",
       "title": "Карточки команд в чате", "title_en": "Command cards in the chat",
       "settings": [{"key": "enabled", "type": "bool", "label": "Показывать карточку под ответом", "label_en": "Show the card under the answer", "default": true}]}
    ]
  }
}
