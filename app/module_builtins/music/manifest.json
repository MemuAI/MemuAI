                "normalize",
                "normalize_target",
                "crossfade",
                "gapless",
                "auto_radio",
                "auto_lyrics",
                "lyrics_sync",
                "auto_analyze",
                "resume_long",
                "seek_step",
                "play_click",
                "show_genres",
