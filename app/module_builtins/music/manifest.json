          "like this track"
        ]
      },
      {
        "id": "delete_track",
        "title": "Удалить трек",
        "title_en": "Delete a track",
        "run": {
          "handler": "music.delete_track"
        },
        "danger": true,
        "description": "Удалить трек из библиотеки по точному id; по названию — только показать кандидатов. Файл удаляется только с явным флагом",
        "description_en": "Delete a track from the library by exact id; by name — only list candidates. The file is removed only with an explicit flag",
        "args": {
          "type": "object",
          "properties": {
            "track_id": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "delete_file": {
              "type": "boolean",
              "description": "also delete the file"
            }
          }
        },
        "phrases": [
          "удали трек {query}",
          "удали из библиотеки {query}"
        ],
        "phrases_en": [
