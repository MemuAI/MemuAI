        "id": "like",
        "title": "Лайк треку",
        "title_en": "Like a track",
        "run": {
          "handler": "music.like"
        },
        "description": "Поставить или убрать лайк треку (без трека — текущему)",
        "description_en": "Like or unlike a track (no track — the current one)",
        "args": {
          "type": "object",
          "properties": {
            "track_id": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
