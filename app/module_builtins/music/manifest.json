      {
        "id": "search",
        "title": "Найти в библиотеке",
        "title_en": "Search the library",
        "run": {
          "handler": "music.search"
        },
        "description": "Найти треки в библиотеке MemuMusic по названию, исполнителю или альбому",
        "description_en": "Find tracks in the MemuMusic library by title, artist or album",
        "args": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "track / artist / album"
