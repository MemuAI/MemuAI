k and progress to the aftermath, and when portraying violence, do realistic descriptions without getting into gory details. Take consent for granted, assuming boundaries will be stated if required.}}{{trim}}","system_prompt":false,"marker":false,"enabled":false,"injection_position":0,"injection_depth":4,"injection_order":100,"injection_trigger":[],"forbid_overrides":false},{"identifier":"cb442cc1-5b17-4365-9ec5-9348002c040a","name":"➁ One Sentence","role":"system","content":"{{setvar::length::to one sentence/dialogue line plus one follow-up tag long}}{{trim}}","system_prompt":false,"marker":false,"enabled":false,"injection_position":0,"injection_depth":4,"injection_order":100,"injection_trigger":[],"forbid_overrides":false},{"identifier":"8c5d4621-b565-4651-b30c-1f1a241fd76f","name":"➅ Chapter","role":"system","content":"{{setvar::length::chapter-long, from 2000 to 8000 words}}{{trim}}","system_prompt":false,"marker":false,"enabled":false,"injection_position":0,"injection_depth":4,"injection_order":100,"injection_trigger":[],"forbid_overrides":false},{"identifier":"58cec410-bd0b-4a5e-872e-b16f01461201","name":"┌ <role>","role":"system","content":"<role>","system_prompt":false,"marker":false,"enabled":false,"injection_position":0,"injection_depth":4,"injection_order":100,"injection_trigger":[],"forbid_overrides":false},{"identifier":"35cdd532-dfc3-4739-b404-1864b7f82269","name":"└ </role>","role":"system","content":"</role>","system_prompt":false,"marker":false,"enabled":false,"injection_position":0,"injection_depth":4,"injection_order":100,"injection_trigger":[],"forbid_overrides":false},{"identifier":"ebbc94e5-f5ca-425e-9210-be40f64c0098","name":"┌ <instructions>","role":"system","content":"\n<instructions>","system_prompt":false,"marker":false,"enabled":false,"injection_position":0,"injection_depth":4,"injection_order":100,"injection_trigger":[],"forbid_overrides":false},{"identifier":"738693f4-31e5-44bb-88ed-dcd4d8e20665","name":"└ </instructions>","role":"system