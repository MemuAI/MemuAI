{
  "manifest_version": 3,
  "name": "MemuAI",
  "description": "Чаты MemuAI, контекст страниц и добровольное управление Chrome через локальный MemuAI.",
  "version": "3.8.46",
  "minimum_chrome_version": "120",
  "permissions": ["sidePanel", "storage", "tabs", "activeTab", "scripting", "alarms", "debugger"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "side_panel": {"default_path": "panel.html"},
  "options_page": "options.html",
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "action": {"default_title": "Открыть MemuAI", "default_icon":{"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png"}},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"}
}
