# Build outputs (regenerated by build.py / installer)
build/
dist/
*.egg-info/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Generated PyInstaller specs (only installer/setup.spec is hand-written)
*.spec
!installer/setup.spec

# Installer artefacts
/installer/*.exe
/installer/*.partial
/installer/*.sha256

# OAuth client secrets — NEVER commit; build.py reads oauth_clients.local.json
# from the author's machine and bakes it into the build only.
oauth_clients.local.json
app/oauth_build.py

# Local test/dev data
test-appdata/
.dev-data/
.runtime*/
.ui-*/
.memuai-data*/

# Local development, runtime state, and the separately released player
/private-dev/
/README_FOR_AI.md
/AGENTS.md
/audit-results/
/persist/
/overrides/
/MemuMusic/
*.json.lock
*.log
/.ruff_cache/
/tests/prompt_eval/results/
