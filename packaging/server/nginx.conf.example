# Example nginx reverse-proxy config for MemuAI Server (server mode).
#
# The MemuAI server itself listens on 127.0.0.1:8327 only.  This vhost
# terminates HTTPS (certbot / Let's Encrypt) and proxies to it.  No
# self-signed certificates: obtain a real one, e.g.:
#   sudo certbot --nginx -d memu.example.com
#
# Adjust server_name and the certificate paths, then:
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name memu.example.com;

    # Redirect all plain HTTP to HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name memu.example.com;

    ssl_certificate     /etc/letsencrypt/live/memu.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/memu.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 100m;

    location / {
        proxy_pass http://127.0.0.1:8327;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
